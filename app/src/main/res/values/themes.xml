<resources>
	<!-- Base application theme. -->
	<style name="Theme.DNSToggle" parent="Theme.Material3.DayNight.NoActionBar">
		<!-- Primary brand color (Backup for Dynamic Colors) -->
		<item name="colorPrimary">@color/light_accent</item>
		<item name="colorOnPrimary">@color/white</item>

		<!-- Secondary brand color -->
		<item name="colorSecondaryContainer">@color/light_neutral</item>
		<item name="colorOnSecondaryContainer">@color/light_text</item>

		<!-- Background and text colors -->
		<item name="android:colorBackground">@color/light_background</item>
		<item name="colorSurface">@color/light_background</item>
		<item name="colorOnSurface">@color/light_text</item>
		<item name="colorOnSurfaceVariant">@color/light_text_variant</item>
		<item name="android:textColorPrimary">@color/light_text</item>

		<!-- Outline / Border -->
		<item name="colorOutline">@color/light_outline</item>

		<item name="warning_color">@color/warning_color</item>

		<!-- Status bar color. -->
		<item name="android:statusBarColor">?attr/colorSurface</item>
		<item name="android:windowLightStatusBar">true</item>
	</style>

	<!-- Floating Dialog Theme -->
	<style name="Theme.DNSToggle.Dialog" parent="Theme.DNSToggle">
		<!-- Transparent window -->
		<item name="android:windowIsTranslucent">true</item>
		<item name="android:windowBackground">@android:color/transparent</item>

		<!-- Centered window sized based on contents -->
		<item name="android:windowIsFloating">true</item>

		<!-- Dimmed background of main UI behind the dialog -->
		<item name="android:backgroundDimEnabled">true</item>
		<item name="android:backgroundDimAmount">0.5</item>

		<!-- Removes title bar -->
		<item name="android:windowNoTitle">true</item>

		<!-- Close on outside tap -->
		<item name="android:windowCloseOnTouchOutside">true</item>
	</style>

	<!-- Fully Transparent Theme for headless toggle -->
	<style name="Theme.Transparent" parent="Theme.Material3.DayNight.NoActionBar">
		<item name="android:windowIsTranslucent">true</item>
		<item name="android:windowBackground">@android:color/transparent</item>
		<item name="android:windowContentOverlay">@null</item>
		<item name="android:windowNoTitle">true</item>
		<item name="android:windowIsFloating">true</item>
		<item name="android:backgroundDimEnabled">false</item>
		<item name="android:windowAnimationStyle">@null</item>
		<item name="android:windowDisablePreview">true</item>
	</style>
</resources>