<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
	<include
		domain="sharedpref"
		path="." />

	<!-- Exclude encrypted properties which cannot be restored -->
	<exclude
		domain="sharedpref"
		path="encrypted_prefs.xml" />

	<!-- Exclude fallback backup encryption keys used if keystore is unavailable -->
	<exclude
		domain="sharedpref"
		path="encryption_fallback_prefs.xml" />

</full-backup-content>
