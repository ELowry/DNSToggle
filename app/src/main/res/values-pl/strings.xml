    <string name="auto_save_state_summary">Zapamiętuj ręczne włączanie i wyłączanie prywatnego DNS w poszczególnych sieciach Wi-Fi.</string>
    <string name="auto_save_host_title">Automatycznie zapisuj nazwy hostów DNS</string>
    <string name="auto_save_host_summary">Zapamiętuj wybór konkretnego serwera DNS podczas połączenia z siecią Wi-Fi.</string>
