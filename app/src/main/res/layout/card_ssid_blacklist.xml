<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/cardSsidBlacklist"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	app:cardCornerRadius="12dp"
	app:cardElevation="0dp"
	app:strokeColor="?attr/colorOutline"
	app:strokeWidth="1dp"
	tools:showIn="@layout/activity_main">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="12dp">

		<RelativeLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginHorizontal="4dp">

			<TextView
				android:id="@+id/tvSsidBlacklistTitle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_alignParentStart="true"
				android:layout_centerVertical="true"
				android:text="@string/ssid_blacklist_title"
				android:textAppearance="?attr/textAppearanceTitleMedium"
				android:textStyle="bold" />

			<ImageButton
				android:id="@+id/btnSsidInfo"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:layout_centerVertical="true"
				android:layout_toEndOf="@id/tvSsidBlacklistTitle"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:clickable="true"
				android:contentDescription="@string/info_content_description"
				android:focusable="true"
				android:src="@drawable/ic_info" />

			<ImageButton
				android:id="@+id/btnAddSsid"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:layout_alignParentEnd="true"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:clickable="true"
				android:contentDescription="@string/add_ssid"
				android:focusable="true"
				android:src="@drawable/ic_add" />
		</RelativeLayout>

		<TextView
			android:id="@+id/tvPermissionNotice"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:text="@string/grant_permission_notice"
			android:textColor="?attr/colorError"
			android:visibility="gone" />

		<Button
			android:id="@+id/btnGrantPermission"
			style="@style/Widget.Material3.Button.TextButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/grant_permission_button"
			android:visibility="gone" />

		<View
			android:id="@+id/dividerSsidList"
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:layout_marginTop="16dp"
			android:background="?attr/colorOutlineVariant" />

		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/ssidListContainer"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:nestedScrollingEnabled="false"
			android:orientation="vertical"
			app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
			tools:listitem="@layout/item_ssid" />

		<com.google.android.material.divider.MaterialDivider
			android:id="@+id/dividerSsidSettings"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp" />

		<LinearLayout
			android:id="@+id/rowAutoBlacklist"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:background="@drawable/bg_row_selectable"
			android:clickable="true"
			android:focusable="true"
			android:focusableInTouchMode="false"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:padding="4dp">

			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/switchAutoBlacklist"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:clickable="false"
				android:duplicateParentState="true"
				android:focusable="false"
				android:text="@string/auto_blacklist_on_disable"
				android:textAppearance="?attr/textAppearanceBodyLarge" />
		</LinearLayout>

		<LinearLayout
			android:id="@+id/rowAutoWhitelist"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="2dp"
			android:background="@drawable/bg_row_selectable"
			android:clickable="true"
			android:focusable="true"
			android:focusableInTouchMode="false"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:padding="4dp">

			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/switchAutoWhitelist"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:clickable="false"
				android:duplicateParentState="true"
				android:focusable="false"
				android:text="@string/auto_whitelist_on_enable"
				android:textAppearance="?attr/textAppearanceBodyLarge" />
		</LinearLayout>

		<LinearLayout
			android:id="@+id/rowConnectivityWatchdogToggle"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:background="@drawable/bg_row_selectable"
			android:clickable="true"
			android:focusable="true"
			android:focusableInTouchMode="false"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:padding="4dp">

			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:orientation="vertical"
				android:paddingStart="0dp"
				android:paddingEnd="16dp">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/connectivity_watchdog_toggle"
					android:textAppearance="?attr/textAppearanceBodyLarge" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text="@string/connectivity_watchdog_info_text"
					android:textAppearance="?attr/textAppearanceBodySmall"
					android:textColor="?attr/colorOnSurfaceVariant" />
			</LinearLayout>

			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/switchConnectivityWatchdog"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:clickable="false"
				android:duplicateParentState="true"
				android:focusable="false" />
		</LinearLayout>

		<!-- Sub-settings with hierarchy -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:paddingStart="8dp"
			android:paddingTop="4dp"
			android:paddingEnd="0dp">

			<View
				android:id="@+id/watchdogConnector"
				android:layout_width="2dp"
				android:layout_height="match_parent"
				android:background="?attr/colorOutlineVariant" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="8dp"
				android:orientation="vertical">

				<LinearLayout
					android:id="@+id/rowConnectivityWatchdogDebounce"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:background="@drawable/bg_row_selectable"
					android:clickable="true"
					android:focusable="true"
					android:focusableInTouchMode="false"
					android:gravity="center_vertical"
					android:minHeight="48dp"
					android:orientation="horizontal"
					android:padding="4dp">

					<TextView
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:text="@string/connectivity_watchdog_debounce_label"
						android:textAppearance="?attr/textAppearanceBodyMedium" />

					<TextView
						android:id="@+id/tvConnectivityWatchdogDebounceValue"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:textAppearance="?attr/textAppearanceBodySmall"
						android:textColor="?attr/colorPrimary"
						tools:text="15s" />

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:layout_marginStart="4dp"
						android:contentDescription="@null"
						android:src="@drawable/ic_chevron_right"
						app:tint="?attr/colorOnSurfaceVariant" />
				</LinearLayout>

				<LinearLayout
					android:id="@+id/rowConnectivityWatchdogTargets"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:background="@drawable/bg_row_selectable"
					android:clickable="true"
					android:focusable="true"
					android:focusableInTouchMode="false"
					android:gravity="center_vertical"
					android:minHeight="48dp"
					android:orientation="horizontal"
					android:padding="4dp">

					<TextView
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:text="@string/connectivity_watchdog_targets_label"
						android:textAppearance="?attr/textAppearanceBodyMedium" />

					<TextView
						android:id="@+id/tvConnectivityWatchdogTargetsValue"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:ellipsize="end"
						android:maxWidth="120dp"
						android:maxLines="1"
						android:textAppearance="?attr/textAppearanceBodySmall"
						android:textColor="?attr/colorPrimary"
						tools:text="91.198.174.192, 103.102.166.224, 173.239.79.196" />

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:layout_marginStart="4dp"
						android:contentDescription="@null"
						android:src="@drawable/ic_chevron_right"
						app:tint="?attr/colorOnSurfaceVariant" />
				</LinearLayout>
			</LinearLayout>
		</LinearLayout>

	</LinearLayout>
</com.google.android.material.card.MaterialCardView>
