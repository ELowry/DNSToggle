<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/rowUsbDebuggingTile"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:gravity="center_vertical"
	android:orientation="horizontal"
	android:visibility="gone">

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:orientation="vertical">

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/show_usb_debugging_tile"
			android:textAppearance="?attr/textAppearanceBodyLarge" />

		<TextView
			android:id="@+id/tvUsbDebuggingTileSummary"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:text="@string/show_usb_debugging_tile_summary"
			android:textAppearance="?attr/textAppearanceBodySmall"
			android:textColor="?attr/colorOnSurfaceVariant" />
	</LinearLayout>

	<com.google.android.material.materialswitch.MaterialSwitch
		android:id="@+id/switchUsbDebuggingTile"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginStart="16dp" />
</LinearLayout>
