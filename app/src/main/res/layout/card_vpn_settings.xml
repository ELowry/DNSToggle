<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/cardVpnSettings"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	app:cardCornerRadius="12dp"
	app:cardElevation="0dp"
	app:strokeColor="?attr/colorOutline"
	app:strokeWidth="1dp"
	tools:showIn="@layout/activity_main">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="12dp">

		<RelativeLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginHorizontal="4dp">

			<TextView
				android:id="@+id/tvVpnOverrideTitle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_alignParentStart="true"
				android:layout_centerVertical="true"
				android:text="@string/vpn_override_title"
				android:textAppearance="?attr/textAppearanceTitleMedium"
				android:textStyle="bold" />

			<ImageButton
				android:id="@+id/btnVpnInfo"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:layout_centerVertical="true"
				android:layout_toEndOf="@id/tvVpnOverrideTitle"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:clickable="true"
				android:contentDescription="@string/vpn_override_title"
				android:focusable="true"
				android:src="@drawable/ic_info" />
		</RelativeLayout>

		<TextView
			android:id="@+id/tvVpnOverrideSummary"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginHorizontal="4dp"
			android:layout_marginTop="2dp"
			android:text="@string/vpn_override_summary"
			android:textAppearance="?attr/textAppearanceBodySmall"
			android:textColor="?attr/colorOnSurfaceVariant" />

		<TextView
			android:id="@+id/tvVpnPermissionNotice"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:text="@string/vpn_permission_notice"
			android:textColor="?attr/colorError"
			android:visibility="gone" />

		<Button
			android:id="@+id/btnGrantVpnPermission"
			style="@style/Widget.Material3.Button.TextButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/grant_permission_button"
			android:visibility="gone" />

		<LinearLayout
			android:id="@+id/rowVpnOverrideToggle"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:background="@drawable/bg_row_selectable"
			android:clickable="true"
			android:focusable="true"
			android:focusableInTouchMode="false"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:padding="4dp">

			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/vpn_override_toggle_label"
				android:textAppearance="?attr/textAppearanceBodyLarge" />

			<com.google.android.material.materialswitch.MaterialSwitch
				android:id="@+id/switchVpnOverride"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:clickable="false"
				android:duplicateParentState="true"
				android:focusable="false" />
		</LinearLayout>

		<LinearLayout
			android:id="@+id/rowVpnDns"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="2dp"
			android:background="@drawable/bg_row_selectable"
			android:clickable="true"
			android:focusable="true"
			android:focusableInTouchMode="false"
			android:gravity="center_vertical"
			android:minHeight="48dp"
			android:orientation="horizontal"
			android:padding="4dp">

			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/vpn_dns_label"
				android:textAppearance="?attr/textAppearanceBodyLarge" />

			<TextView
				android:id="@+id/tvVpnDnsValue"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:textAppearance="?attr/textAppearanceBodyMedium"
				android:textColor="?attr/colorPrimary"
				tools:text="@string/automatic_off" />

			<ImageView
				android:layout_width="20dp"
				android:layout_height="20dp"
				android:layout_marginStart="4dp"
				android:contentDescription="@null"
				android:src="@drawable/ic_chevron_right"
				app:tint="?attr/colorOnSurfaceVariant" />
		</LinearLayout>

	</LinearLayout>
</com.google.android.material.card.MaterialCardView>
