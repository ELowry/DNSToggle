<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/main"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fitsSystemWindows="false"
	tools:context=".ui.MainActivity">

	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/appBarLayout"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:liftOnScroll="true">

		<com.google.android.material.appbar.MaterialToolbar
			android:id="@+id/topAppBar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			app:logo="@drawable/ic_qs_dns"
			app:logoDescription="@null"
			app:title="@string/app_name">

			<ImageButton
				android:id="@+id/btnMenu"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:layout_gravity="end"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:clickable="true"
				android:contentDescription="@string/menu_content_description"
				android:focusable="true"
				android:src="@drawable/ic_overflow"
				app:tint="?attr/colorOnSurface" />

		</com.google.android.material.appbar.MaterialToolbar>

	</com.google.android.material.appbar.AppBarLayout>

	<androidx.core.widget.NestedScrollView
		android:id="@+id/mainScrollView"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:fillViewport="true"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">

		<androidx.constraintlayout.widget.ConstraintLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="12dp">

			<androidx.constraintlayout.widget.Guideline
				android:id="@+id/guideStart"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				app:layout_constraintGuide_percent="0.5" />

			<androidx.constraintlayout.widget.ConstraintLayout
				android:id="@+id/contentWrapper"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent"
				app:layout_constraintWidth_max="600dp">

				<include
					android:id="@+id/cardMainPermissionLayout"
					layout="@layout/view_main_permission"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:visibility="gone"
					app:layout_constraintEnd_toEndOf="parent"
					app:layout_constraintStart_toStartOf="parent"
					app:layout_constraintTop_toTopOf="parent" />

				<com.google.android.material.card.MaterialCardView
					android:id="@+id/cardOverrideStatus"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="16dp"
					android:visibility="gone"
					app:cardBackgroundColor="?attr/colorPrimaryContainer"
					app:cardElevation="0dp"
					app:layout_constraintEnd_toEndOf="parent"
					app:layout_constraintStart_toStartOf="parent"
					app:layout_constraintTop_toBottomOf="@id/cardMainPermissionLayout"
					app:strokeColor="?attr/colorPrimary"
					app:strokeWidth="1.5dp">

					<TextView
						android:id="@+id/tvOverrideStatus"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:drawablePadding="12dp"
						android:gravity="center_vertical"
						android:padding="12dp"
						android:textAppearance="?attr/textAppearanceBodyMedium"
						android:textColor="?attr/colorOnPrimaryContainer"
						android:textStyle="bold"
						app:drawableStartCompat="@drawable/ic_info_i"
						app:drawableTint="?attr/colorPrimary"
						tools:text="@string/status_override_vpn" />
				</com.google.android.material.card.MaterialCardView>

				<include
					android:id="@+id/dnsSettings"
					layout="@layout/card_dns_settings"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="24dp"
					app:layout_constraintTop_toBottomOf="@id/cardOverrideStatus" />

				<include
					android:id="@+id/wifiProfiles"
					layout="@layout/card_wifi_profiles"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="24dp"
					app:layout_constraintTop_toBottomOf="@id/dnsSettings" />

				<include
					android:id="@+id/vpnSettings"
					layout="@layout/card_vpn_settings"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="24dp"
					app:layout_constraintTop_toBottomOf="@id/wifiProfiles" />

				<TextView
					android:id="@+id/tvOptionsTitle"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginStart="4dp"
					android:layout_marginTop="36dp"
					android:layout_marginEnd="4dp"
					android:text="@string/options_title"
					android:textAppearance="?attr/textAppearanceTitleLarge"
					android:textStyle="bold"
					app:layout_constraintEnd_toEndOf="parent"
					app:layout_constraintStart_toStartOf="parent"
					app:layout_constraintTop_toBottomOf="@id/vpnSettings" />

				<LinearLayout
					android:id="@+id/rowShowToast"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="16dp"
					android:background="@drawable/bg_row_selectable"
					android:clickable="true"
					android:focusable="true"
					android:focusableInTouchMode="false"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:padding="4dp"
					app:layout_constraintEnd_toEndOf="parent"
					app:layout_constraintStart_toStartOf="parent"
					app:layout_constraintTop_toBottomOf="@id/tvOptionsTitle">

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/show_toast_notif"
							android:textAppearance="?attr/textAppearanceBodyLarge" />

						<TextView
							android:id="@+id/tvShowToastSummary"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="6dp"
							android:text="@string/show_toast_notif_summary"
							android:textAppearance="?attr/textAppearanceBodySmall"
							android:textColor="?attr/colorOnSurfaceVariant" />
					</LinearLayout>

					<com.google.android.material.materialswitch.MaterialSwitch
						android:id="@+id/switchShowToast"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="16dp"
						android:clickable="false"
						android:duplicateParentState="true"
						android:focusable="false" />
				</LinearLayout>

				<LinearLayout
					android:id="@+id/rowHideLauncher"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dp"
					android:background="@drawable/bg_row_selectable"
					android:clickable="true"
					android:focusable="true"
					android:focusableInTouchMode="false"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:padding="4dp"
					app:layout_constraintEnd_toEndOf="parent"
					app:layout_constraintStart_toStartOf="parent"
					app:layout_constraintTop_toBottomOf="@id/rowShowToast">

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical">

						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/hide_launcher_icon"
							android:textAppearance="?attr/textAppearanceBodyLarge" />

						<TextView
							android:id="@+id/tvHideLauncherSummary"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="6dp"
							android:text="@string/hide_launcher_icon_summary"
							android:textAppearance="?attr/textAppearanceBodySmall"
							android:textColor="?attr/colorOnSurfaceVariant" />
					</LinearLayout>

					<com.google.android.material.materialswitch.MaterialSwitch
						android:id="@+id/switchHideLauncher"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginStart="16dp"
						android:clickable="false"
						android:duplicateParentState="true"
						android:focusable="false" />
				</LinearLayout>

				<include
					android:id="@+id/rowUsbDebuggingTileLayout"
					layout="@layout/view_usb_debugging_tile"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="18dp"
					android:visibility="gone"
					app:layout_constraintEnd_toEndOf="parent"
					app:layout_constraintStart_toStartOf="parent"
					app:layout_constraintTop_toBottomOf="@id/rowHideLauncher" />

				<com.google.android.material.divider.MaterialDivider
					android:id="@+id/dividerFooter"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="48dp"
					app:layout_constraintTop_toBottomOf="@id/rowUsbDebuggingTileLayout" />

				<LinearLayout
					android:id="@+id/footerContainer"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="16dp"
					android:layout_marginBottom="24dp"
					android:gravity="center"
					android:orientation="vertical"
					app:layout_constraintEnd_toEndOf="parent"
					app:layout_constraintStart_toStartOf="parent"
					app:layout_constraintTop_toBottomOf="@id/dividerFooter">

					<LinearLayout
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:orientation="horizontal">

						<com.google.android.material.button.MaterialButton
							android:id="@+id/btnGithub"
							style="@style/Widget.Material3.Button.TextButton"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/github"
							android:textColor="?attr/colorPrimary"
							app:icon="@drawable/ic_code"
							app:iconPadding="8dp"
							app:iconTint="?attr/colorPrimary" />

						<com.google.android.material.button.MaterialButton
							android:id="@+id/btnSupport"
							style="@style/Widget.Material3.Button.TextButton"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/support"
							android:textColor="?attr/colorPrimary"
							app:icon="@drawable/ic_bug_report"
							app:iconPadding="8dp"
							app:iconTint="?attr/colorPrimary" />
					</LinearLayout>

					<com.google.android.material.button.MaterialButton
						android:id="@+id/btnWhatsNew"
						style="@style/Widget.Material3.Button.TextButton"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="0dp"
						android:text="@string/whats_new"
						android:textColor="?attr/colorPrimary"
						android:visibility="gone"
						app:icon="@drawable/ic_new"
						app:iconPadding="8dp"
						app:iconTint="?attr/colorPrimary"
						tools:visibility="visible" />

					<TextView
						android:id="@+id/tvAppVersion"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:focusable="false"
						android:focusableInTouchMode="false"
						android:textAppearance="?attr/textAppearanceBodySmall"
						android:textColor="?attr/colorOutline"
						tools:text="Version 1.0.0" />
				</LinearLayout>

			</androidx.constraintlayout.widget.ConstraintLayout>

		</androidx.constraintlayout.widget.ConstraintLayout>
	</androidx.core.widget.NestedScrollView>

	<View
		android:id="@+id/statusBarBackground"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:background="?attr/colorSurface"
		android:elevation="8dp"
		android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
