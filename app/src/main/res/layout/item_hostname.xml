<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginHorizontal="2dp"
	android:layout_marginVertical="4dp"
	android:clickable="true"
	android:clipChildren="false"
	android:clipToPadding="false"
	android:focusable="false"
	android:foreground="?attr/selectableItemBackground"
	android:stateListAnimator="@animator/m3_card_bounce"
	app:cardBackgroundColor="?attr/colorSurfaceContainer"
	app:cardCornerRadius="12dp"
	app:cardElevation="0dp"
	app:strokeColor="?attr/colorOutlineVariant"
	app:strokeWidth="1dp">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:animateLayoutChanges="true"
		android:clipChildren="false"
		android:clipToPadding="false"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingVertical="2dp"
		android:paddingStart="4dp"
		android:paddingEnd="4dp">

		<LinearLayout
			android:id="@+id/hostnameInfoContainer"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:background="@drawable/bg_focus_only"
			android:clickable="false"
			android:focusable="true"
			android:focusableInTouchMode="false"
			android:orientation="vertical"
			android:paddingVertical="2dp"
			android:paddingStart="8dp"
			android:paddingEnd="6dp">

			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:id="@+id/tvHostname"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textAppearance="?attr/textAppearanceBodyLarge"
					android:textColor="?attr/colorOnSurface"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/tvDefaultBadge"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="8dp"
					android:background="@drawable/bg_pill_badge"
					android:paddingHorizontal="4dp"
					android:paddingVertical="2dp"
					android:text="@string/default_badge"
					android:textAllCaps="true"
					android:textColor="?attr/colorOnSecondaryContainer"
					android:textSize="10sp"
					android:textStyle="bold"
					android:visibility="gone"
					tools:visibility="visible" />
			</LinearLayout>

			<TextView
				android:id="@+id/tvSecondaryHostname"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:textAppearance="?attr/textAppearanceBodySmall"
				android:textColor="?attr/colorOnSurfaceVariant"
				android:visibility="gone" />

			<TextView
				android:id="@+id/tvStatus"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:textAppearance="?attr/textAppearanceBodySmall"
				android:visibility="gone" />
		</LinearLayout>

		<ImageButton
			android:id="@+id/btnEditHostname"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:clickable="true"
			android:contentDescription="@string/edit_hostname"
			android:focusable="true"
			android:src="@drawable/ic_edit"
			app:tint="?attr/colorOnSurfaceVariant" />

		<ImageButton
			android:id="@+id/btnDeleteHostname"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:clickable="true"
			android:contentDescription="@string/delete_hostname_confirm"
			android:focusable="true"
			android:src="@drawable/ic_delete"
			app:tint="?attr/colorOnSurfaceVariant" />

		<ImageButton
			android:id="@+id/btnAddHostnameInPlace"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:clickable="true"
			android:contentDescription="@string/add_hostname_desc"
			android:focusable="true"
			android:src="@drawable/ic_save"
			android:visibility="gone"
			app:tint="?attr/colorPrimary" />

	</LinearLayout>

	<View
		android:id="@+id/unsavedBorder"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@drawable/bg_dashed_border_12dp"
		android:clickable="false"
		android:focusable="false"
		android:visibility="gone" />
</com.google.android.material.card.MaterialCardView>
